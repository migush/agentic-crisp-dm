# Example reverse-proxy config for adding the account product alongside
# whatever already proxies to the trace dashboard at maads.mirogeorgiev.eu.
# Copy the relevant block into the box's real Caddyfile — this repo does not
# manage that file directly, since the domain is deployed manually (see
# webapp/README.md).
#
# Caddy gets free automatic HTTPS (Let's Encrypt) with no config beyond this.

maads.mirogeorgiev.eu {
	# Existing dashboard (leave as-is / adjust to match current config)
	handle /dashboard* {
		reverse_proxy 127.0.0.1:8765
	}

	# New account product: API
	handle /api/* {
		reverse_proxy 127.0.0.1:8766
	}

	# New account product: built frontend static assets
	handle {
		root * /srv/maads-webapp/dist
		try_files {path} /index.html
		file_server
	}
}
