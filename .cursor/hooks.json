{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/check-python.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/protect-git.sh",
        "failClosed": false
      }
    ]
  }
}
